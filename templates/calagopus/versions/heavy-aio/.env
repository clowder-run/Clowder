CALAGOPUS_HOST=${CALAGOPUS_SERVICE_NAME}.${CLOWDER_DOMAIN}
CALAGOPUS_SFTP_PORT=2022
TZ=Etc/UTC
APP_ENCRYPTION_KEY={{ 32 }}
DATABASE_URL=postgresql://{{ db.POSTGRES_USER }}:{{ db.POSTGRES_PASSWORD }}@{{ db.POSTGRES_INTERNAL_HOST }}:5432/{{ db.POSTGRES_DB }}
REDIS_URL=redis://:{{ cache.REDIS_PASSWORD }}@{{ cache.CACHE_INTERNAL_HOST }}:6379
