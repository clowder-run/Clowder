---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    <ClientRouter />
    {import.meta.env.PROD && (
      <>
        <script is:inline defer src="https://rum.irazz.lol/script.js" data-website-id="1a3882d7-9ee9-4d1d-8d95-90bfe1c058d6"></script>
        <script is:inline defer src="https://rum.irazz.lol/recorder.js" data-website-id="1a3882d7-9ee9-4d1d-8d95-90bfe1c058d6"></script>
      </>
    )}
    <script is:inline>
      // Applies the saved accent before first paint, and again after each client-side navigation swaps <html>.
      // Keep the list in sync with src/components/accent-switcher.tsx.
      function applyAccent() {
        const accent = document.cookie.match(/(?:^|; )accent=(lime|teal|sky|violet|pink|orange|mono)(?:;|$)/)?.[1];

        if (accent) document.documentElement.dataset.accent = accent;
      }

      applyAccent();

      document.addEventListener('astro:after-swap', applyAccent);
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <slot />
  </body>
</html>
