---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '@/layouts/Layout.astro';
import { Docs } from '@/components/docs';
import { OpenAPIDocs } from '@/components/openapi-docs';
import { source } from '@/lib/source';
import { getPageImageUrl, gitConfig } from '@/lib/shared';

export const prerender = true;

export const getStaticPaths = (() => {
  return source.getPages().map((page) => ({
    params: { slug: decodeURI(page.slugs.join('/')) || undefined },
    props: { page },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;

// Generated API reference pages have no MDX body.
const content = page.type === 'docs' ? await page.data.load() : undefined;

const Content = content?.body;

const pageTree = await source.serializePageTree(source.getPageTree());
---

<Layout
  title={page.data.title}
  description={page.data.description}
  image={getPageImageUrl(page).url}
>
    {page.type === 'openapi' && (
        <OpenAPIDocs
          client:load
          pathname={Astro.url.pathname}
          params={Astro.params}
          tree={pageTree}
          title={page.data.title}
          page={page.data.getOpenAPIPageProps()}
        />
    )}
    {page.type === 'docs' && content && Content && (
        <div class="">
            <Docs
              client:load
              transition:persist="docs"
              pathname={Astro.url.pathname}
              params={Astro.params}
              tree={pageTree}
              title={page.data.title}
              description={page.data.description}
              toc={content.toc}
              markdownUrl={`${page.url}.md`}
              githubUrl={`https://github.com/${gitConfig.user}/${gitConfig.repo}/blob/${gitConfig.branch}/apps/docs/content/docs/${encodeURI(page.path)}`}
            >
                <Content />
            </Docs>
        </div>
    )}
</Layout>
